import {
  createFacadeHandle,
  createMarkoRoute,
  getFacadeValue,
  getRouteComponentInput,
  type MarkoRoute,
  type RouteComponent,
  type RouteComponentOption,
  type RouteFacade,
} from "../runtime.js";

export interface Input {
  parent: RouteFacade;
  path: string;
  loader?: (context: any) => any;
  component:
    Marko.AttrTag<{ content: RouteComponent }> | (() => RouteComponentOption);
}

<const/handle=createFacadeHandle()>
<const/createRoute=() =>
  createMarkoRoute({
    parent: input.parent.api(),
    path: input.path,
    component: getRouteComponentInput(input.component),
    loader: input.loader,
  })>
<const/getRoute=() => getFacadeValue(handle, createRoute) as MarkoRoute>
<return={ api: getRoute } as RouteFacade<MarkoRoute>>
