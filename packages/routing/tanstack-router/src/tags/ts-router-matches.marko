import {
  getMatchIds,
  getMatchRenderData,
  type RouterFacade,
} from "../runtime.js";

export interface Input {
  router: RouterFacade;
  revision: number;
}

<const/router=input.router>
<const/revision=input.revision>
<const/matchIds=getMatchIds(router.api(), revision)>
<define/renderMatch|index: number|>
  <define/outlet>
    <if=matchIds[index + 1]>
      <${renderMatch}(index + 1)/>
    </if>
  </define>
  <const/renderData=getMatchRenderData(
    router.api(),
    matchIds[index],
    outlet.content,
  )>

  <if=renderData.component>
    <if=renderData.kind === "error">
      <${renderData.component}({
        error: renderData.error,
        info: { componentStack: "" },
        reset: () => router.api().invalidate(),
      })/>
    </if>
    <else>
      <${renderData.component}(renderData.input)/>
    </else>
  </if>
  <else>
    <${outlet.content}/>
  </else>
</define>

<if=matchIds.length>
  <${renderMatch}(0)/>
</if>
