import {
  initializeDefaultRouter,
  prepareRouter,
  type RouterFacade,
  type RouterServerResponse,
} from "../runtime.js";

export interface Input {
  router: RouterFacade;
  onServerPrepared?: (response: RouterServerResponse) => void;
}

<const/router=initializeDefaultRouter($global, input.router)>
<const/preparedRouter=prepareRouter(router.api())>
<let/revision=0>
<lifecycle
  onMount() {
    const current = router.api();
    const matches = current.stores.matches.subscribe(() => {
      revision = revision + 1;
    });
    const unsubscribeHistory = current.history.subscribe(current.load);
    return { matches, unsubscribeHistory };
  }
  onDestroy() {
    this.matches.unsubscribe();
    this.unsubscribeHistory();
  }
>
<await|prepared|=preparedRouter>
  <const/reported=(
    prepared.response ? input.onServerPrepared?.(prepared.response) : undefined
  )>
  <tsr-router-matches router=router revision=revision/>
  <if=prepared.script>
    <html-script>${prepared.script};</html-script>
  </if>
</await>
