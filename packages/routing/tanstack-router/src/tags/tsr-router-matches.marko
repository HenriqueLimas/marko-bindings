import {
  getGlobalNotFoundRenderData,
  getMatchComponent,
  getMatchRenderData,
  getMatchState,
  getRouterForHandle,
  type RouterFacade,
} from "../runtime.js";

export interface Input {
  router: RouterFacade;
  revision: number;
}

<const/matchState=getMatchState(input.router, input.revision)>
<define/renderMatch|index: number|>
  <define/outlet>
    <const/notFound=getGlobalNotFoundRenderData(
      getRouterForHandle(matchState.routerHandle),
      matchState.matchIds[index],
      matchState.revision,
    )>
    <if=notFound.active>
      <if=notFound.hasComponent>
        <${notFound.component}(notFound.input)/>
      </if>
      <else>
        <p>Not Found</p>
      </else>
    </if>
    <else-if=(matchState.matchIds[index + 1])>
      <${renderMatch}(index + 1)/>
    </else-if>
  </define>
  <const/renderData=getMatchRenderData(
    getRouterForHandle(matchState.routerHandle),
    matchState.matchIds[index],
    outlet.content,
    matchState.revision,
  )>

  <if=renderData.hasComponent>
    <if=renderData.kind === "error">
      <${
        getMatchComponent(
          getRouterForHandle(matchState.routerHandle),
          matchState.matchIds[index],
        )
      }({
        error: renderData.error,
        info: { componentStack: "" },
        reset: () => getRouterForHandle(matchState.routerHandle).invalidate(),
      })/>
    </if>
    <else>
      <${
        getMatchComponent(
          getRouterForHandle(matchState.routerHandle),
          matchState.matchIds[index],
        )
      }(renderData.input)/>
    </else>
  </if>
  <else-if=renderData.kind === "notFound">
    <p>Not Found</p>
  </else-if>
  <else-if=renderData.kind === "component">
    <${outlet.content}/>
  </else-if>
</define>

<if=matchState.matchIds.length>
  <${renderMatch}(0)/>
</if>
