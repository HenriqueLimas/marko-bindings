import type { RouterServerResponse } from "../../src/runtime.js";

export interface Input {
  url: URL;
  onServerPrepared?: (response: RouterServerResponse) => void;
}

<tsr-root-route/rootRoute>
  <@component|{ content }|>
    <main>
      <h1>Root layout</h1>
      <nav>
        <tsr-link to="/">Home</tsr-link>
        <tsr-link to="/about">About</tsr-link>
      </nav>
      <${content}/>
    </main>
  </@component>
</tsr-root-route>

<tsr-route/indexRoute parent=rootRoute path="/">
  <@component>
    <h2>Home page</h2>
  </@component>
</tsr-route>

<tsr-route/aboutRoute parent=rootRoute path="/about">
  <@component>
    <h2>About page</h2>
  </@component>
</tsr-route>

<tsr-route/searchRoute parent=rootRoute path="/search">
  <@component|{ route }|>
    <h2>Search page</h2>
    <p>Search value: ${route.search.value}</p>
    <tsr-link to="/search?value=two">Change search</tsr-link>
  </@component>
</tsr-route>

<tsr-route-tree/routeTree
  root=rootRoute
  children=[indexRoute, aboutRoute, searchRoute]
/>
<tsr-router/router routeTree=routeTree url=input.url/>
<tsr-router-provider
  router=router
  onServerPrepared=(response) => input.onServerPrepared?.(response)
/>
