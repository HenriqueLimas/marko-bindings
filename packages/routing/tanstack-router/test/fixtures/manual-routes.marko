export interface Input {
  url: URL;
}

<tsr-root-route/rootRoute>
  <@component|{ content }|>
    <main>
      <h1>Root layout</h1>
      <nav>
        <tsr-link to="/">Home</tsr-link>
        <tsr-link to="/about">About</tsr-link>
      </nav>
      <${content}/>
    </main>
  </@component>
</tsr-root-route>

<tsr-route/indexRoute parent=rootRoute path="/">
  <@component>
    <h2>Home page</h2>
  </@component>
</tsr-route>

<tsr-route/aboutRoute parent=rootRoute path="/about">
  <@component>
    <h2>About page</h2>
  </@component>
</tsr-route>

<tsr-route-tree/routeTree root=rootRoute children=[indexRoute, aboutRoute]/>
<tsr-router/router routeTree=routeTree url=input.url/>
<tsr-router-provider router=router/>
