export interface Input {
  url: URL;
}

<ts-root-route/rootRoute>
  <@component|{ outlet }|>
    <main>
      <h1>Root layout</h1>
      <nav>
        <ts-router-link to="/">Home</ts-router-link>
        <ts-router-link to="/about">About</ts-router-link>
      </nav>
      <${outlet}/>
    </main>
  </@component>
</ts-root-route>

<ts-route/indexRoute parent=rootRoute path="/">
  <@component>
    <h2>Home page</h2>
  </@component>
</ts-route>

<ts-route/aboutRoute parent=rootRoute path="/about">
  <@component>
    <h2>About page</h2>
  </@component>
</ts-route>

<ts-route-tree/routeTree root=rootRoute children=[indexRoute, aboutRoute]/>
<ts-router/router routeTree=routeTree url=input.url/>
<ts-router-provider router=router/>
