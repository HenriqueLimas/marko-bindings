export interface Input {
  url: URL;
}

<create-root-route/rootRoute>
  <@component|{ outlet }|>
    <${outlet}/>
  </@component>
</create-root-route>

<create-route/postRoute
  parent=rootRoute
  path="/posts/$postId"
  loader=({ params }) => ({ title: `Post ${params.postId}` })
>
  <@component|{ route }|>
    <h1>${route.loaderData.title}</h1>
    <output>${route.params.postId}</output>
  </@component>
</create-route>

<create-route-tree/routeTree root=rootRoute children=[postRoute]/>
<create-router/router routeTree=routeTree url=input.url/>
<router-provider router=router/>
