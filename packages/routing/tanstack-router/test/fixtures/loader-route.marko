export interface Input {
  url: URL;
}

<tsr-root-route/rootRoute>
  <@component|{ content }|>
    <${content}/>
  </@component>
</tsr-root-route>

<tsr-route/postRoute
  parent=rootRoute
  path="/posts/$postId"
  loader=({ params }) => ({ title: `Post ${params.postId}` })
>
  <@component|{ route }|>
    <h1>${route.loaderData.title}</h1>
    <output>${route.params.postId}</output>
  </@component>
</tsr-route>

<tsr-route-tree/routeTree root=rootRoute children=[postRoute]/>
<tsr-router/router routeTree=routeTree url=input.url/>
<tsr-router-provider router=router/>
