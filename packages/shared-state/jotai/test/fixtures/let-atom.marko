import type { createStore, PrimitiveAtom } from "jotai/vanilla";

export interface Input {
  atom: PrimitiveAtom<number>;
  store: ReturnType<typeof createStore>;
}

<init-jotai-store=() => input.store/>
<let-atom/value=() => input.atom/>
<output>${value}</output>
<button onClick() {
  value += 5;
}>
  Add five
</button>
