import { type createStore } from "@marko-bindings/jotai";
import { atomWithReset } from "@marko-bindings/jotai/utils";

export interface Input {
  store?: ReturnType<typeof createStore>;
}

<const/countAtom=atomWithReset(1)>
<let-atom/count=() => countAtom store=() => input.store/>
<const-reset-atom/reset=() => countAtom store=() => input.store/>

<output>${count}</output>
<button onClick() {
  count += 5;
}>
  Add five
</button>
<button onClick=reset>Reset</button>
