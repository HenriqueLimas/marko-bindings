import { type Atom, type createStore } from "@marko-bindings/jotai";

export interface Input {
  atom: Atom<Promise<number>>;
  store?: ReturnType<typeof createStore>;
}

<try>
  <await-atom|num|=() => input.atom store=() => input.store>
    <output>${num}</output>
  </await-atom>

  <@placeholder>Loading...</@placeholder>
  <@catch|error|>${String(error)}</@catch>
</try>
