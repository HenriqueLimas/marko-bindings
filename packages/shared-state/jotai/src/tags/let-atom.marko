import { getDefaultStore, type WritableAtom } from "jotai/vanilla";
import { getStoreContext } from "../context.js";
import ObserveAtom from "../internal/observe-atom.marko";

export interface Input<T> {
  value: () => WritableAtom<T, [NoInfer<T>], unknown>;
  store?: () => ReturnType<typeof getDefaultStore> | undefined;
}

static {
  function resolveStore<T>(input: Input<T>, global: unknown) {
    const getStore = input.store;
    const store =
      typeof getStore === "function"
        ? getStore()
        : (getStoreContext(global) as
            ReturnType<typeof getDefaultStore> | undefined);
    return store ?? getDefaultStore();
  }
}

<ObserveAtom/value value=input.value store=input.store/>
<return=value as T
  valueChange(next: T) {
    const browserAtom = input.value();
    const browserStore = resolveStore(input, $global);
    browserStore.set(browserAtom, next);
  }
>
