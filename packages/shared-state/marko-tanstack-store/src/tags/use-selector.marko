import type { Readable } from "@tanstack/store";

export interface Input<TState, TSelected> {
  value: (state: TState) => TSelected;
  store: Readable<TState>;
  compare?: (previous: TSelected, next: TSelected) => boolean;
}

<const/selector=input.value>
<const/store=input.store>
<const/compare=input.compare ?? Object.is>
<let/selected: TSelected=selector(store.get())>
<script>
  let current = selector(store.get());
  selected = current;
  const subscription = store.subscribe((state) => {
    const next = selector(state);
    if (!compare(current, next)) {
      selected = current = next;
    }
  });

  $signal.onabort = () => subscription.unsubscribe();
</script>

<return=selected>
