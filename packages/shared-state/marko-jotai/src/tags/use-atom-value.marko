import { type Atom, getDefaultStore } from "jotai/vanilla";

export interface Input<T> {
  value: Atom<T>;
  store?: ReturnType<typeof getDefaultStore>;
  content?: Marko.Body<[Awaited<T>]>;
}

<const/atom=input.value>
<const/store=input.store ?? getDefaultStore()>
<let/value=store.get(atom)>
<script>
  value = store.get(atom);
  const unsubscribe = store.sub(atom, () => {
    value = store.get(atom);
  });

  $signal.onabort = unsubscribe;
</script>

<if=input.content>
  <await|resolvedValue|=value>
    <${input.content}(resolvedValue)/>
  </await>
</if>

<return=value>
