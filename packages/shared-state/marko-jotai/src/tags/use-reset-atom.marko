import { getDefaultStore, type WritableAtom } from "jotai/vanilla";
import { RESET } from "jotai/vanilla/utils";

export interface Input<T> {
  value: () => WritableAtom<unknown, [typeof RESET], T>;
  store?: () => ReturnType<typeof getDefaultStore> | undefined;
}

<const/reset=() =>
  (input.store?.() ?? getDefaultStore()).set(input.value(), RESET)>
<return=reset>
