import { type Atom, type createStore } from "marko-jotai";

export interface Input {
  atom: Atom<Promise<number>>;
  store?: ReturnType<typeof createStore>;
}

<try>
  <use-atom-value|num|=input.atom store=input.store>
    <output>${num}</output>
  </use-atom-value>

  <@placeholder>Loading...</@placeholder>
  <@catch|error|>${String(error)}</@catch>
</try>
