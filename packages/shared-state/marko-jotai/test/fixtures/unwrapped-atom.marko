import { type Atom, type createStore } from "marko-jotai";
import { unwrap } from "marko-jotai/utils";

export interface Input {
  atom: Atom<Promise<number>>;
  store?: ReturnType<typeof createStore>;
}

<const/unwrappedAtom=unwrap(input.atom)>
<const-atom/value=() => unwrappedAtom store=() => input.store/>

<if=value === undefined><output>Loading...</output></if>
<if=value !== undefined><output>${value}</output></if>
