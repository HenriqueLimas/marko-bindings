import {
  FieldApi,
  FormApi,
  type AnyFormOptions,
  type AnyFormState,
  type DeepKeys,
  type DeepValue,
  type FieldAsyncValidateOrFn,
  type FieldOptions,
  type FieldValidateOrFn,
  type UpdateMetaOptions,
  type Updater,
} from "@tanstack/form-core";

export interface FormBinding<TFormData> {
  readonly _data: TFormData;
  api(): unknown;
  _options(): unknown;
  _state(): unknown;
}

export interface Input<
  TParentData,
  TName extends DeepKeys<TParentData>,
  TData extends DeepValue<TParentData, TName>,
  TOnMount extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
  TOnChange extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
  TOnChangeAsync extends
    undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
  TOnBlur extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
  TOnBlurAsync extends
    undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
  TOnSubmit extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
  TOnSubmitAsync extends
    undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
  TOnDynamic extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
  TOnDynamicAsync extends
    undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
> extends FieldOptions<
  TParentData,
  TName,
  TData,
  TOnMount,
  TOnChange,
  TOnChangeAsync,
  TOnBlur,
  TOnBlurAsync,
  TOnSubmit,
  TOnSubmitAsync,
  TOnDynamic,
  TOnDynamicAsync
> {
  form: FormBinding<TParentData>;
  mode?: "value" | "array";
}

static {
  type BoundFieldApi<
    TParentData,
    TName extends DeepKeys<TParentData>,
    TData extends DeepValue<TParentData, TName>,
    TOnMount extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnChange extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnChangeAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnBlur extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnBlurAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnSubmit extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnSubmitAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnDynamic extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnDynamicAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
  > = FieldApi<
    TParentData,
    TName,
    TData,
    TOnMount,
    TOnChange,
    TOnChangeAsync,
    TOnBlur,
    TOnBlurAsync,
    TOnSubmit,
    TOnSubmitAsync,
    TOnDynamic,
    TOnDynamicAsync,
    any,
    any,
    any,
    any,
    any,
    any,
    any,
    any,
    any,
    any,
    any
  >;

  function getInitialState<
    TParentData,
    TName extends DeepKeys<TParentData>,
    TData extends DeepValue<TParentData, TName>,
    TOnMount extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnChange extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnChangeAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnBlur extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnBlurAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnSubmit extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnSubmitAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
    TOnDynamic extends undefined | FieldValidateOrFn<TParentData, TName, TData>,
    TOnDynamicAsync extends
      undefined | FieldAsyncValidateOrFn<TParentData, TName, TData>,
  >(
    formOptions: AnyFormOptions,
    formState: AnyFormState,
    fieldOptions: FieldOptions<
      TParentData,
      TName,
      TData,
      TOnMount,
      TOnChange,
      TOnChangeAsync,
      TOnBlur,
      TOnBlurAsync,
      TOnSubmit,
      TOnSubmitAsync,
      TOnDynamic,
      TOnDynamicAsync
    >,
  ): BoundFieldApi<
    TParentData,
    TName,
    TData,
    TOnMount,
    TOnChange,
    TOnChangeAsync,
    TOnBlur,
    TOnBlurAsync,
    TOnSubmit,
    TOnSubmitAsync,
    TOnDynamic,
    TOnDynamicAsync
  >["state"] {
    const form = new FormApi({
      ...formOptions,
      defaultState: formState,
      defaultValues: formState.values,
    });
    return new FieldApi({ ...fieldOptions, form } as never)
      .state as BoundFieldApi<
      TParentData,
      TName,
      TData,
      TOnMount,
      TOnChange,
      TOnChangeAsync,
      TOnBlur,
      TOnBlurAsync,
      TOnSubmit,
      TOnSubmitAsync,
      TOnDynamic,
      TOnDynamicAsync
    >["state"];
  }
}

<const/getFormApi=input.form.api as () => FormApi<
  any,
  any,
  any,
  any,
  any,
  any,
  any,
  any,
  any,
  any,
  any,
  any
>>
<const/getFormOptions=input.form._options as () => AnyFormOptions>
<const/getFormState=input.form._state as () => AnyFormState>
<const/name=input.name>
<const/mode=input.mode ?? "value">
<const/fieldOptions={
  name,
  defaultValue: input.defaultValue,
  asyncDebounceMs: input.asyncDebounceMs,
  asyncAlways: input.asyncAlways,
  defaultMeta: input.defaultMeta,
  disableErrorFlat: input.disableErrorFlat,
  validators: input.validators,
  listeners: input.listeners,
} as FieldOptions<
  TParentData,
  TName,
  TData,
  TOnMount,
  TOnChange,
  TOnChangeAsync,
  TOnBlur,
  TOnBlurAsync,
  TOnSubmit,
  TOnSubmitAsync,
  TOnDynamic,
  TOnDynamicAsync
>>
<let/api=(
  undefined as
    | BoundFieldApi<
        TParentData,
        TName,
        TData,
        TOnMount,
        TOnChange,
        TOnChangeAsync,
        TOnBlur,
        TOnBlurAsync,
        TOnSubmit,
        TOnSubmitAsync,
        TOnDynamic,
        TOnDynamicAsync
      >
    | undefined
)>
<let/state=getInitialState(getFormOptions(), getFormState(), fieldOptions)>
<const/getApi=() => {
  const form = getFormApi();
  if (!api || api.form !== form || api.name !== fieldOptions.name) {
    api = new FieldApi({ ...fieldOptions, form } as never) as typeof api;
  }
  return api!;
}>
<const/handleChange=(value: Updater<TData>) => getApi().handleChange(value)>
<const/handleBlur=() => getApi().handleBlur()>
<const/pushValue=(
  value: TData extends any[] ? TData[number] : never,
  options?: UpdateMetaOptions,
) => getApi().pushValue(value, options)>
<const/insertValue=(
  index: number,
  value: TData extends any[] ? TData[number] : never,
  options?: UpdateMetaOptions,
) => getApi().insertValue(index, value, options)>
<const/replaceValue=(
  index: number,
  value: TData extends any[] ? TData[number] : never,
  options?: UpdateMetaOptions,
) => getApi().replaceValue(index, value, options)>
<const/removeValue=(index: number, options?: UpdateMetaOptions) =>
  getApi().removeValue(index, options)>
<const/swapValues=(
  firstIndex: number,
  secondIndex: number,
  options?: UpdateMetaOptions,
) => getApi().swapValues(firstIndex, secondIndex, options)>
<const/moveValue=(
  fromIndex: number,
  toIndex: number,
  options?: UpdateMetaOptions,
) => getApi().moveValue(fromIndex, toIndex, options)>
<const/clearValues=(options?: UpdateMetaOptions) =>
  getApi().clearValues(options)>
<const/publishState=(
  current: NonNullable<typeof api>,
  currentMode: "value" | "array",
) => {
  const next = current.state;
  const previous = state;

  if (
    currentMode !== "array" ||
    next.meta._arrayVersion !== previous.meta._arrayVersion ||
    next.meta.isTouched !== previous.meta.isTouched ||
    next.meta.isBlurred !== previous.meta.isBlurred ||
    next.meta.isDirty !== previous.meta.isDirty ||
    next.meta.errorMap !== previous.meta.errorMap ||
    next.meta.errorSourceMap !== previous.meta.errorSourceMap ||
    next.meta.isValidating !== previous.meta.isValidating
  ) {
    state = next;
  }
}>
<lifecycle
  onMount() {
    const current = getApi();
    const subscription = current.store.subscribe(() => {
      publishState(current, this.currentMode);
    });
    const unmount = current.mount();
    state = current.state;
    return { current, currentMode: mode, subscription, unmount };
  }
  onUpdate() {
    const current = getApi();
    this.currentMode = mode;
    if (current !== this.current) {
      this.subscription.unsubscribe();
      this.unmount();
      this.current = current;
      this.subscription = current.store.subscribe(() => {
        publishState(current, this.currentMode);
      });
      this.unmount = current.mount();
      state = current.state;
    } else {
      publishState(current, mode);
    }
    current.update({ ...fieldOptions, form: getFormApi() });
  }
  onDestroy() {
    this.subscription.unsubscribe();
    this.unmount();
  }
>

<return={
  name,
  state: {
    ...state,
    valueChange(value: Updater<TData>) {
      handleChange(value);
    },
  },
  handleChange,
  handleBlur,
  pushValue,
  insertValue,
  replaceValue,
  removeValue,
  swapValues,
  moveValue,
  clearValues,
  api: getApi,
}>
