import {
  type ApolloClient,
  type TypedDocumentNode,
} from "@marko-bindings/apollo-client";

export interface DogFragment {
  __typename: "Dog";
  id: string;
  name: string;
}

export interface Input {
  client: () => ApolloClient | undefined;
  fragment: () => TypedDocumentNode<DogFragment>;
  from: string | { __typename: string; id: string };
}

<const-fragment/result
  client=input.client
  fragment=input.fragment
  from=input.from
/>
<output>
  <span>${result.data.name ?? "Unknown dog"}</span>
  <span>${result.complete ? "Complete" : "Partial"}</span>
</output>
