import {
  ApolloClient,
  ApolloLink,
  InMemoryCache,
} from "@marko-bindings/apollo-client";
import { DOG_FRAGMENT } from "./dog-fragment.js";

export function createPopulatedClient() {
  const client = new ApolloClient({
    cache: new InMemoryCache(),
    link: ApolloLink.empty(),
    ssrMode: true,
  });
  client.writeFragment({
    fragment: DOG_FRAGMENT,
    data: { __typename: "Dog", id: "1", name: "Buck" },
  });
  return client;
}

server function createServerClient() {
  return createPopulatedClient();
}

client function createBrowserClient() {
  return createPopulatedClient();
}

export const createFragmentClient =
  typeof createServerClient === "undefined"
    ? createBrowserClient
    : createServerClient;
