import {
  type ApolloClient,
  type TypedDocumentNode,
} from "@marko-bindings/apollo-client";

import type { DogFragment } from "./const-fragment.marko";

export interface Input {
  client: () => ApolloClient | undefined;
  fragment: () => TypedDocumentNode<DogFragment>;
  from: Array<string | null>;
}

<const-fragment/result
  client=input.client
  fragment=input.fragment
  from=input.from
/>
<output>${result.data.map((dog) => dog?.name ?? "Missing").join(", ")}</output>
