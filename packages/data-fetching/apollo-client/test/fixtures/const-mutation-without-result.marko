import {
  type ApolloClient,
  type TypedDocumentNode,
} from "@marko-bindings/apollo-client";

import type {
  GreetingMutation,
  GreetingVariables,
} from "./const-mutation.marko";

export interface Input {
  client: () => ApolloClient | undefined;
  mutation: () => TypedDocumentNode<GreetingMutation, GreetingVariables>;
}

<const-mutation/[mutate] client=input.client mutation=input.mutation/>
<button
  type="button"
  onClick() {
    void mutate({ variables: { greeting: "Hello without result" } });
  }
>
  Mutate without result
</button>
