import {
  type QueryClient,
  type QueryObserverOptions,
} from "marko-tanstack-query";

export interface Input {
  client: () => QueryClient | undefined;
  query: () => QueryObserverOptions<
    { greeting: string },
    Error,
    string,
    { greeting: string },
    readonly ["selected-greeting"]
  >;
}

<try>
  <use-query|result| client=input.client query=input.query>
    <output>${result.data ?? "No greeting"}</output>
  </use-query>

  <@placeholder><output>Loading...</output></@placeholder>
  <@catch|error|><output>${String(error)}</output></@catch>
</try>
