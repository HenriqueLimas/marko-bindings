import {
  type QueryClient,
  type QueryObserverOptions,
} from "@marko-bindings/tanstack-query";

export interface Greeting {
  greeting: string;
}

export interface Input {
  client?: () => QueryClient | undefined;
  query: () => QueryObserverOptions<
    Greeting,
    Error,
    Greeting,
    Greeting,
    readonly ["greeting"]
  >;
}

<const-query/result client=input.client query=input.query/>
<output>
  <if=result.error>${String(result.error)}</if>
  <else>${result.data?.greeting ?? "No greeting"}</else>
</output>
<div data-testid="status">${result.status}:${result.fetchStatus}</div>
