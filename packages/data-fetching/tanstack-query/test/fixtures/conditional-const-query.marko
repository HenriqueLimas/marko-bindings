import {
  type QueryClient,
  type QueryObserverOptions,
} from "@marko-bindings/tanstack-query";

export interface Greeting {
  greeting: string;
}

export interface Input {
  client: () => QueryClient;
  query: () => QueryObserverOptions<Greeting>;
  show: boolean;
}

<if=input.show>
  <const-query/result client=input.client query=input.query/>
  <output>${result.data?.greeting ?? "No greeting"}</output>
</if>
