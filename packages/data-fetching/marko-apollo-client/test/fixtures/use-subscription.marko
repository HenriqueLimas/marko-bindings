import { type ApolloClient, type TypedDocumentNode } from "marko-apollo-client";

export interface TickSubscription {
  tick: number;
}

export interface Input {
  client: () => ApolloClient | undefined;
  subscription: () => TypedDocumentNode<TickSubscription>;
}

<use-subscription|result| client=input.client subscription=input.subscription>
  <output>
    <if=result.loading>Loading...</if>
    <else-if=result.error>Error: ${result.error.message}</else-if>
    <else>${result.data?.tick ?? "No tick"}</else>
  </output>
</use-subscription>
