import { type ApolloClient, type TypedDocumentNode } from "marko-apollo-client";

import type { GreetingMutation, GreetingVariables } from "./use-mutation.marko";

export interface Input {
  client: () => ApolloClient | undefined;
  mutation: () => TypedDocumentNode<GreetingMutation, GreetingVariables>;
}

<use-mutation/mutate client=input.client mutation=input.mutation/>
<button
  type="button"
  onClick() {
    void mutate({ variables: { greeting: "Hello without content" } });
  }
>
  Mutate without content
</button>
