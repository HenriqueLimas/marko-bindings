import {
  type ApolloClient,
  type ErrorLike,
  type MaybeMasked,
  type OperationVariables,
} from "@apollo/client";
import { toErrorLike } from "@apollo/client/errors";

export type Mutation<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = () => ApolloClient.MutateOptions<TData, TVariables>["mutation"];

export type Options<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = Omit<
  ApolloClient.MutateOptions<TData, TVariables>,
  "mutation" | "variables"
> & {
  variables?: TVariables;
};

export type Mutate<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = (
  options?: Options<TData, TVariables>,
) => Promise<ApolloClient.MutateResult<MaybeMasked<TData>>>;

export interface Result<TData = unknown> {
  called: boolean;
  loading: boolean;
  data: MaybeMasked<TData> | undefined;
  error: ErrorLike | undefined;
  reset: () => void;
}

export type Input<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = Options<TData, TVariables> & {
  client: () => ApolloClient | undefined;
  mutation: Mutation<TData, TVariables>;
};

static function inputError(name: "client" | "mutation") {
  const error = new Error(`<const-mutation> requires a ${name} input.`);
  console.error(error.message);
  return error;
}

<const/execution={ current: 0 }>
<let/result={
  called: false,
  loading: false,
  data: undefined,
  error: undefined,
} as Omit<Result<TData>, "reset">>
<const/reset=() => {
  execution.current++;
  result = {
    called: false,
    loading: false,
    data: undefined,
    error: undefined,
  };
}>
<const/mutate=async (
  mutationOptions?: Options<TData, TVariables>,
): Promise<ApolloClient.MutateResult<MaybeMasked<TData>>> => {
  const currentExecution = ++execution.current;
  const getClient = input.client;
  const client = typeof getClient === "function" ? getClient() : undefined;
  if (!client) {
    const error = inputError("client");
    result = {
      called: true,
      loading: false,
      data: undefined,
      error,
    };
    throw error;
  }

  const getMutation = input.mutation;
  if (typeof getMutation !== "function") {
    const error = inputError("mutation");
    result = {
      called: true,
      loading: false,
      data: undefined,
      error,
    };
    throw error;
  }

  const {
    client: _client,
    mutation: _mutation,
    variables: defaultVariables,
    ...defaultOptions
  } = input;
  const variables =
    defaultVariables || mutationOptions?.variables
      ? { ...defaultVariables, ...mutationOptions?.variables }
      : undefined;
  result = {
    called: true,
    loading: true,
    data: undefined,
    error: undefined,
  };

  try {
    const mutationResult = await client.mutate<TData, TVariables>({
      ...defaultOptions,
      ...mutationOptions,
      mutation: getMutation(),
      variables,
    } as unknown as ApolloClient.MutateOptions<TData, TVariables>);

    if (execution.current === currentExecution) {
      result = {
        called: true,
        loading: false,
        data: mutationResult.data,
        error: mutationResult.error,
      };
    }

    return mutationResult;
  } catch (error) {
    if (execution.current === currentExecution) {
      result = {
        called: true,
        loading: false,
        data: undefined,
        error: toErrorLike(error),
      };
    }

    throw error;
  }
}>
<script>
  $signal.onabort = () => {
    execution.current++;
  };
</script>

<return=[mutate, { ...result, reset }] as const>
