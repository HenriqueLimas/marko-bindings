import type { ApolloClient } from "@apollo/client";

import { provideApolloClient } from "../internal.js";

export interface Input {
  client: ApolloClient;
  content?: Marko.Body;
}

<const/client=provideApolloClient($global, input.client)>

<if=input.content>
  <${input.content}/>
</if>

<return=client>
