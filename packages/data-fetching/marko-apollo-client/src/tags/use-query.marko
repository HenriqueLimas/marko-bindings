import {
  type ApolloClient,
  type MaybeMasked,
  NetworkStatus,
  type ObservableQuery,
  type OperationVariables,
} from "@apollo/client";

export type Input<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = ApolloClient.WatchQueryOptions<TData, TVariables> & {
  client: ApolloClient;
};

<const/pendingResult = {
  data: undefined,
  dataState: "empty",
  loading: true,
  networkStatus: NetworkStatus.loading,
  partial: false,
} as ObservableQuery.Result<MaybeMasked<TData>>>;

<const/{ client, ...options }=input>
<const/query=client.watchQuery(
  options as ApolloClient.WatchQueryOptions<TData, TVariables>,
)>
<let/result=pendingResult as ObservableQuery.Result<MaybeMasked<TData>>>
<script>
  result = query.getCurrentResult();
  const subscription = query.subscribe((next) => {
    result = next;
  });

  $signal.onabort = () => {
    subscription.unsubscribe();
    query.stop();
  };
</script>

<return=result>
