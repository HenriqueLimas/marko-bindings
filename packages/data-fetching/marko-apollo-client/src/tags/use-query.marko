import {
  type ApolloClient,
  type MaybeMasked,
  NetworkStatus,
  type ObservableQuery,
  type OperationVariables,
} from "@apollo/client";

export type Input<
  TData = unknown,
  TVariables extends OperationVariables = OperationVariables,
> = ApolloClient.WatchQueryOptions<TData, TVariables> & {
  client: ApolloClient | undefined;
};

<const/pendingResult={
  data: undefined,
  dataState: "empty",
  loading: true,
  networkStatus: NetworkStatus.loading,
  partial: false,
} as ObservableQuery.Result<MaybeMasked<TData>>>
<const/{ client, ...options }=input>
<const/query=client?.watchQuery(
  options as ApolloClient.WatchQueryOptions<TData, TVariables>,
)>
<let/result=pendingResult as ObservableQuery.Result<MaybeMasked<TData>>>
<script>
  if (!query) {
    console.error("<use-query> requires a client input.");
    result = pendingResult;
    return;
  }

  const activeQuery = query;
  result = activeQuery.getCurrentResult();
  const subscription = activeQuery.subscribe((next) => {
    result = next;
  });

  $signal.onabort = () => {
    subscription.unsubscribe();
    activeQuery.stop();
  };
</script>

<return=result>
