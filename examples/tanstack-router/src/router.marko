import { BOOKS_QUERY_KEY, booksQuery } from "./books-query.js";
import { createClient } from "./query-client.marko";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="TanStack Router with Marko and direct Vite SSR"
    >
    <title>Marko × TanStack Router</title>
  </head>
  <body>
    <init-query-client=() => createClient()/>
    <const/requestUrl=(
      $global.url instanceof URL ? $global.url : new URL("http://localhost")
    )>
    <const/booksApiUrl=new URL("/api/books", requestUrl).href>

    <create-root-route/rootRoute>
      <@component|{ outlet }|>
        <header>
          <a class="brand" href="/">Marko × TanStack Router</a>
          <nav aria-label="Primary navigation">
            <router-link to="/">Home</router-link>
            <router-link to="/about">About</router-link>
            <router-link to="/query">Query</router-link>
            <router-link to="/posts/42">Post 42</router-link>
          </nav>
        </header>
        <main>
          <${outlet}/>
        </main>
      </@component>
    </create-root-route>

    <create-route/homeRoute parent=rootRoute path="/">
      <@component>
        <section class="hero">
          <p class="eyebrow">Vite SSR · No Marko Run</p>
          <h1>Manual routes,<br><em>resumable navigation.</em></h1>
          <p>
            This document is rendered by a custom Node server and resumed by the
            browser modules discovered through <code>?marko-server-entry</code>.
          </p>
        </section>
      </@component>
    </create-route>

    <create-route/aboutRoute
      parent=rootRoute
      path="/about"
      loader=() => ({ renderedAt: new Date().toISOString() })
    >
      <@component|{ route }|>
        <section>
          <p class="eyebrow">Route loader</p>
          <h1>About this example</h1>
          <p>
            The server loaded this route at
            <time>${route.loaderData.renderedAt}</time>. TanStack's hydration transport
            carries that data into the resumed browser router.
          </p>
        </section>
      </@component>
    </create-route>

    <create-route/queryRoute parent=rootRoute path="/query">
      <@component>
        <section>
          <p class="eyebrow">TanStack Query</p>
          <h1>Server data,<br><em>resumed cache.</em></h1>
          <p>
            This route fetches <a href="/api/books"><code>/api/books</code></a>
            during SSR and hydrates the same query in the browser.
          </p>

          <div class="query-card" aria-live="polite">
            <try>
              <await-query|result| query=() => booksQuery(booksApiUrl)>
                <if=result.error>
                  <p role="alert">${result.error.message}</p>
                </if>
                <else>
                  <ul>
                    <for|book| of=result.data?.books ?? []>
                      <li>
                        <strong>${book.title}</strong>
                        <span>${book.author}</span>
                      </li>
                    </for>
                  </ul>
                  <footer>
                    <span>API request #${result.data?.requestNumber}</span>
                    <button
                      type="button"
                      onClick() {
                        void createClient().invalidateQueries({
                          queryKey: BOOKS_QUERY_KEY,
                        });
                      }
                    >
                      Refresh query
                    </button>
                  </footer>
                </else>
              </await-query>

              <@placeholder>
                <p role="status">Loading books…</p>
              </@placeholder>
              <@catch|error|>
                <p role="alert">
                  ${error instanceof Error ? error.message : String(error)}
                </p>
              </@catch>
            </try>
          </div>
        </section>
      </@component>
    </create-route>

    <create-route/postRoute
      parent=rootRoute
      path="/posts/$postId"
      loader=({ params }) => ({
        title: `Post ${params.postId}`,
        body: "Params and loader data stay local to the active route.",
      })
    >
      <@component|{ route }|>
        <article>
          <p class="eyebrow">Dynamic route · ${route.params.postId}</p>
          <h1>${route.loaderData.title}</h1>
          <p>${route.loaderData.body}</p>
        </article>
      </@component>
    </create-route>

    <create-route-tree/routeTree
      root=rootRoute
      children=[homeRoute, aboutRoute, queryRoute, postRoute]
    />
    <create-router/router routeTree=routeTree/>
    <router-provider router=router/>

    <style>
      :root {
        color: #202421;
        background: #f3f0e8;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 20rem;
        margin: 0;
      }

      header {
        display: flex;
        gap: 2rem;
        align-items: center;
        justify-content: space-between;
        width: min(68rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 1.25rem 0;
        border-bottom: 1px solid #c8c4b8;
      }

      .brand {
        color: #17362e;
        font-weight: 800;
        text-decoration: none;
      }

      nav {
        display: flex;
        gap: 1rem;
      }

      nav a {
        color: #9b431f;
        font-weight: 700;
        text-underline-offset: 0.25rem;
      }

      main {
        display: grid;
        align-items: center;
        width: min(68rem, calc(100% - 2rem));
        min-height: calc(100vh - 5rem);
        margin: 0 auto;
        padding: 4rem 0;
      }

      section,
      article {
        max-width: 48rem;
      }

      .eyebrow {
        color: #a84922;
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.8rem 0 1.5rem;
        color: #17362e;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 500;
        letter-spacing: -0.055em;
        line-height: 0.92;
      }

      h1 em {
        color: #a84922;
        font-weight: inherit;
      }

      p {
        color: #626b65;
        font-size: 1.05rem;
        line-height: 1.75;
      }

      code,
      time {
        color: #803718;
      }

      .query-card {
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #d4d0c4;
        border-radius: 1rem;
        background: #fffdf7;
      }

      .query-card ul {
        display: grid;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .query-card li,
      .query-card footer {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
      }

      .query-card li span,
      .query-card footer {
        color: #626b65;
      }

      .query-card footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #dedacf;
      }

      button {
        padding: 0.65rem 0.9rem;
        border: 0;
        border-radius: 0.5rem;
        color: #fff;
        background: #9b431f;
        font: inherit;
        font-weight: 750;
        cursor: pointer;
      }

      @media (max-width: 42rem) {
        header {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.75rem;
        }

        nav {
          flex-wrap: wrap;
        }
      }
    </style>
  </body>
</html>
