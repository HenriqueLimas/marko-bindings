import { createClient } from "./query-client.marko";
import { routeTree } from "./routeTree.gen.js";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta
      name="description"
      content="TanStack Router with Marko and direct Vite SSR"
    >
    <title>Marko × TanStack Router</title>
  </head>
  <body>
    <init-query-client=() => createClient()/>
    <tsr-router/router routeTree=() => routeTree/>
    <tsr-router-provider router=router/>

    <style>
      :root {
        color: #202421;
        background: #f3f0e8;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        font-synthesis: none;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-width: 20rem;
        margin: 0;
      }

      header {
        display: flex;
        gap: 2rem;
        align-items: center;
        justify-content: space-between;
        width: min(68rem, calc(100% - 2rem));
        margin: 0 auto;
        padding: 1.25rem 0;
        border-bottom: 1px solid #c8c4b8;
      }

      .brand {
        color: #17362e;
        font-weight: 800;
        text-decoration: none;
      }

      nav {
        display: flex;
        gap: 1rem;
      }

      nav a {
        color: #9b431f;
        font-weight: 700;
        text-underline-offset: 0.25rem;
      }

      main {
        display: grid;
        align-items: center;
        width: min(68rem, calc(100% - 2rem));
        min-height: calc(100vh - 5rem);
        margin: 0 auto;
        padding: 4rem 0;
      }

      section,
      article {
        max-width: 48rem;
      }

      .eyebrow {
        color: #a84922;
        font-size: 0.75rem;
        font-weight: 850;
        letter-spacing: 0.13em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.8rem 0 1.5rem;
        color: #17362e;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3rem, 8vw, 6.5rem);
        font-weight: 500;
        letter-spacing: -0.055em;
        line-height: 0.92;
      }

      h1 em {
        color: #a84922;
        font-weight: inherit;
      }

      p {
        color: #626b65;
        font-size: 1.05rem;
        line-height: 1.75;
      }

      code,
      time {
        color: #803718;
      }

      .query-card {
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #d4d0c4;
        border-radius: 1rem;
        background: #fffdf7;
      }

      .query-card ul {
        display: grid;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .query-card li,
      .query-card footer {
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: space-between;
      }

      .query-card li span,
      .query-card footer {
        color: #626b65;
      }

      .query-card footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #dedacf;
      }

      button {
        padding: 0.65rem 0.9rem;
        border: 0;
        border-radius: 0.5rem;
        color: #fff;
        background: #9b431f;
        font: inherit;
        font-weight: 750;
        cursor: pointer;
      }

      @media (max-width: 42rem) {
        header {
          align-items: flex-start;
          flex-direction: column;
          gap: 0.75rem;
        }

        nav {
          flex-wrap: wrap;
        }
      }
    </style>
  </body>
</html>
