import { BOOKS_QUERY_KEY, booksQuery } from "../books-query.js";
import { createClient } from "../query-client.marko";

<init-query-client=() => createClient()/>
<const/apiUrl=new URL("/api/books", $global.url).href>

<main>
  <header>
    <div class="eyebrow">Marko Run × TanStack Query</div>
    <h1>Server data,<br><em>resumed cache.</em></h1>
    <p class="intro">
      One Marko Run application renders this query on the server and serves its
      JSON from <a href="/api/books"><code>/api/books</code></a>. TanStack's cache
      resumes in the browser without serializing the query client or fetch function.
      Continue to the <a href="/const-query">
        <code>&lt;const-query&gt;</code> event example
      </a>, or use the <a href="/mutation">mutation example</a> to add and
      refetch a book.
    </p>
  </header>

  <section class="query-card" aria-live="polite">
    <div class="card-heading">
      <div>
        <span class="label">Local API response</span>
        <h2>Speculative fiction</h2>
      </div>
    </div>

    <try>
      <await-query|result| query=() => booksQuery(apiUrl)>
        <if=result.error>
          <p class="error" role="alert">${result.error.message}</p>
        </if>
        <else>
          <ul>
            <for|book| of=result.data?.books ?? []>
              <li>
                <span class="book-mark" aria-hidden="true"/>
                <div>
                  <strong>${book.title}</strong><span>${book.author}</span>
                </div>
              </li>
            </for>
          </ul>

          <footer>
            <p>
              API request <strong>#${result.data?.requestNumber}</strong>
              <span aria-hidden="true">·</span>
              <time datetime=result.data?.servedAt>
                ${
                  result.data?.servedAt
                    ? new Date(result.data.servedAt).toLocaleTimeString()
                    : "Not fetched"
                }
              </time>
            </p>
            <button
              type="button"
              onClick() {
                void createClient().invalidateQueries({
                  queryKey: BOOKS_QUERY_KEY,
                });
              }
            >
              Refresh from API
            </button>
          </footer>
        </else>
      </await-query>

      <@placeholder>
        <div class="loading" role="status">
          <span/><span/><span/>
          <p>Querying the local API…</p>
        </div>
      </@placeholder>
      <@catch|error|>
        <p class="error" role="alert">
          ${error instanceof Error ? error.message : String(error)}
        </p>
      </@catch>
    </try>
  </section>
</main>

<style>
