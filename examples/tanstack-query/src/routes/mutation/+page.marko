import { addBookMutation } from "../../book-mutation.js";
import { booksQuery } from "../../books-query.js";
import { createClient } from "../../query-client.marko";

<init-query-client=() => createClient()/>
<const/apiUrl=new URL("/api/books", $global.url).href>

<main>
  <header>
    <div class="eyebrow">Marko × TanStack mutations</div>
    <h1>Mutate, invalidate,<br><em>stay reactive.</em></h1>
    <p class="intro">
      The initial list is queried during server rendering. After resumption,
      <code>&lt;const-mutation&gt;</code> adds a book and invalidates the same
      TanStack cache entry.
    </p>
    <a class="back" href="/">← Return to the query example</a>
  </header>

  <section class="mutation-card" aria-live="polite">
    <try>
      <await-query|booksResult| query=() => booksQuery(apiUrl)>
        <if=booksResult.error>
          <p class="error" role="alert">${booksResult.error.message}</p>
        </if>
        <else>
          <const-mutation/[addBook, mutationResult] mutation=() =>
            addBookMutation(apiUrl)/>

          <div class="card-heading">
            <div>
              <span class="label">Mutation result</span>
              <h2>Add Kindred</h2>
            </div>
            <button
              type="button"
              disabled=mutationResult.isPending
              onClick() {
                void addBook({
                  title: "Kindred",
                  author: "Octavia E. Butler",
                }).catch(() => {});
              }
            >
              ${mutationResult.isPending ? "Adding…" : "Add book"}
            </button>
          </div>

          <p class=["status", mutationResult.isError && "error"]>
            <if=mutationResult.isPending>
              Adding the book and refetching the list…
            </if>
            <else-if=mutationResult.isError>
              ${mutationResult.error.message}
            </else-if>
            <else-if=mutationResult.isSuccess>
              Added ${mutationResult.data.book.title}; the list below came from the
              invalidated query.
            </else-if>
            <else>The mutation has not run yet.</else>
          </p>

          <ul>
            <for|book| of=booksResult.data?.books ?? []>
              <li>
                <span class="book-mark" aria-hidden="true"/>
                <div>
                  <strong>${book.title}</strong><span>${book.author}</span>
                </div>
              </li>
            </for>
          </ul>
        </else>
      </await-query>

      <@placeholder>
        <div class="loading" role="status">Loading books…</div>
      </@placeholder>
      <@catch|error|>
        <p class="error" role="alert">
          ${error instanceof Error ? error.message : String(error)}
        </p>
      </@catch>
    </try>
  </section>
</main>

<style>
  main {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(32rem, 1.15fr);
    gap: clamp(2.5rem, 8vw, 8rem);
    align-items: center;
    width: min(74rem, calc(100% - 2rem));
    min-height: 100vh;
    margin: 0 auto;
    padding: 4rem 0;
  }

  header {
    max-width: 31rem;
  }

  .eyebrow,
  .label {
    color: #d86d39;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem 0 1.6rem;
    color: #153f34;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(3.4rem, 7vw, 6.25rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 0.88;
  }

  h1 em {
    color: #d86d39;
    font-weight: 500;
  }

  .intro {
    margin: 0 0 1.5rem;
    color: #63726d;
    font-size: 1.04rem;
    line-height: 1.75;
  }

  .back {
    color: #a84822;
    font-weight: 750;
  }

  .mutation-card {
    min-height: 32rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border: 1px solid #d5e0d8;
    border-radius: 1.5rem;
    background: #fffefa;
    box-shadow: 0 2rem 5rem rgb(21 63 52 / 10%);
  }

  .card-heading {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #e4e9e5;
  }

  h2 {
    margin: 0.35rem 0 0;
    color: #173f35;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.8rem;
    font-weight: 500;
  }

  button {
    flex: none;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0.7rem;
    color: white;
    background: #d86d39;
    cursor: pointer;
    font-weight: 750;
  }

  button:hover:not(:disabled) {
    background: #bc5527;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.65;
  }

  .status {
    min-height: 3.5rem;
    margin: 1.25rem 0;
    padding: 1rem;
    border-radius: 0.75rem;
    color: #52665f;
    background: #f0f6f1;
  }

  .error {
    color: #942d24;
    background: #fde9e5;
  }

  ul {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1rem;
    border-radius: 0.9rem;
    background: #f0f6f1;
  }

  .book-mark {
    width: 0.35rem;
    height: 2.7rem;
    border-radius: 1rem;
    background: #d86d39;
  }

  li strong,
  li div span {
    display: block;
  }

  li strong {
    color: #24463d;
  }

  li div span {
    margin-top: 0.25rem;
    color: #728078;
    font-size: 0.9rem;
  }

  .loading {
    display: grid;
    min-height: 21rem;
    place-items: center;
    color: #718078;
  }

  @media (max-width: 60rem) {
    main {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      max-width: 42rem;
      padding: 3rem 0;
    }

    header {
      max-width: 36rem;
    }
  }

  @media (max-width: 38rem) {
    main {
      width: min(100% - 1rem, 42rem);
      padding: 1.5rem 0;
    }

    .mutation-card {
      min-height: 30rem;
      border-radius: 1rem;
    }

    .card-heading {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
