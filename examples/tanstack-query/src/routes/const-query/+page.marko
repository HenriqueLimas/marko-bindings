import { BOOKS_QUERY_KEY, booksQuery } from "../../books-query.js";
import { createClient } from "../../query-client.marko";
import { getClientContext } from "@marko-bindings/tanstack-query";

<init-query-client=() => getClientContext($global) ?? createClient()/>
<const/apiUrl=new URL("/api/books?delay=500", $global.url).href>

<main>
  <header>
    <div class="eyebrow">Marko Run × query events</div>
    <h1>Stream once,<br><em>react throughout.</em></h1>
    <p class="intro">
      The route handler starts an unawaited TanStack prefetch. Marko serializes
      its pending Promise, and <code>&lt;const-query&gt;</code> publishes each
      observer state without owning an async content boundary.
    </p>
    <a class="back" href="/">← Return to the await-query example</a>
  </header>

  <section class="query-card" aria-live="polite">
    <const-query/result query=() => booksQuery(apiUrl)/>
    <div class="card-heading">
      <div>
        <span class="label">Live QueryObserver state</span>
        <h2>Speculative fiction</h2>
      </div>
      <div class="states">
        <span>${result.status}</span>
        <span class=result.isFetching && "fetching">${result.fetchStatus}</span>
      </div>
    </div>

    <if=result.isPending>
      <div class="loading" role="status">
        <span/><span/><span/>
        <p>The server request is streaming…</p>
      </div>
    </if>
    <else-if=result.isError>
      <p class="error" role="alert">${result.error.message}</p>
    </else-if>
    <else>
      <if=result.isFetching>
        <p class="refreshing" role="status">
          Refreshing while the settled list remains visible…
        </p>
      </if>

      <ul>
        <for|book| of=result.data?.books ?? []>
          <li>
            <span class="book-mark" aria-hidden="true"/>
            <div><strong>${book.title}</strong><span>${book.author}</span></div>
          </li>
        </for>
      </ul>

      <footer>
        <p>
          API request <strong>#${result.data?.requestNumber}</strong>
          <span aria-hidden="true">·</span>${result.isFetching ? "fetching" : "settled"}
        </p>
        <button
          type="button"
          onClick() {
            void createClient().invalidateQueries({
              queryKey: BOOKS_QUERY_KEY,
            });
          }
        >
          Refresh from API
        </button>
      </footer>
    </else>
  </section>
</main>

