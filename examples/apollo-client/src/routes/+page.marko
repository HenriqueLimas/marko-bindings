import { ApolloClient, HttpLink, InMemoryCache } from "marko-apollo-client";

import { BOOKS_QUERY } from "../books-query.js";

<let/client=undefined as ApolloClient | undefined>
<script>
  const ownedClient = new ApolloClient({
    cache: new InMemoryCache(),
    link: new HttpLink({ uri: "/gql" }),
  });

  client = ownedClient;
  $signal.onabort = () => ownedClient.stop();
</script>

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Marko Apollo Client example</title>
    <style>
      :root {
        color: #17212b;
        background: #f4f7fa;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 5rem auto;
      }

      .eyebrow {
        color: #6b42d8;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 6vw, 3.75rem);
        line-height: 1;
      }

      .intro {
        color: #52606d;
        line-height: 1.6;
      }

      .result {
        min-height: 12rem;
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #dbe2ea;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 1rem 3rem rgb(23 33 43 / 8%);
      }

      ul {
        display: grid;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      li {
        padding: 1rem;
        border-radius: 0.75rem;
        background: #f4f1ff;
      }

      strong,
      span {
        display: block;
      }

      span {
        margin-top: 0.25rem;
        color: #665f73;
      }

      a {
        color: #6b42d8;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">Marko Run + Apollo</div>
      <h1>Books from a local GraphQL route</h1>
      <p class="intro">
        This page passes a browser-owned Apollo Client directly to
        <code>&lt;use-query&gt;</code>. The same Marko Run application serves Apollo
        Server at <a href="/gql"><code>/gql</code></a>.
      </p>

      <section class="result" aria-live="polite">
        <if=client>
          <use-query/result client=client query=BOOKS_QUERY/>

          <if=result.loading>
            <p>Loading books…</p>
          </if>
          <else-if=result.error>
            <p role="alert">GraphQL error: ${result.error.message}</p>
          </else-if>
          <else>
            <ul>
              <for|book| of=result.data?.books ?? []>
                <li>
                  <strong>${book.title}</strong><span>${book.author}</span>
                </li>
              </for>
            </ul>
          </else>
        </if>
        <else>
          <p>Starting Apollo Client…</p>
        </else>
      </section>
    </main>
  </body>
</html>
