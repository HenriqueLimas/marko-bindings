import { createClient } from "../apollo-client.marko";
import { BOOKS_QUERY } from "../books-query.js";

<div
  class="page"
  style="--theme-accent: #6b42d8; --theme-link: #6b42d8; --theme-surface: #f4f1ff; --theme-detail: #665f73;"
>
  <div class="eyebrow">Marko Run + Apollo</div>
  <h1>Books from a local GraphQL route</h1>
  <p class="intro">
    This page passes a target-specific Apollo Client and parsed query to
    <code>&lt;use-query&gt;</code> through resumable getters. The same Marko Run
    application serves Apollo Server at <a href="/gql"><code>/gql</code></a>. Compare
    it with the <a href="/client-only">client-only query page</a> or the <a href="/fragments">
      fragment cache page
    </a>.
  </p>

  <section class="result result--tall" aria-live="polite">
    <try>
      <use-query|result| client=() => createClient() query=() => BOOKS_QUERY>
        <if=result.error>
          <p role="alert">GraphQL error: ${result.error.message}</p>
        </if>
        <else>
          <ul>
            <for|book| of=result.data?.books ?? []>
              <li><strong>${book.title}</strong><span>${book.author}</span></li>
            </for>
          </ul>
        </else>
      </use-query>

      <@placeholder>
        <p>Loading books…</p>
      </@placeholder>
      <@catch|error|>
        <p role="alert">
          GraphQL error:
          ${error instanceof Error ? error.message : String(error)}
        </p>
      </@catch>
    </try>
  </section>
</div>
