import { createClient } from "../../apollo-client.marko";
import { ADD_BOOK } from "../../book-mutation";
import { BOOKS_QUERY } from "../../books-query";

<div
  class="page"
  style="--theme-accent: #b04a1f; --theme-link: #9b3d18; --theme-surface: #fff3ed; --theme-detail: #665f73;"
>
  <div class="eyebrow">Marko + Apollo operations</div>
  <h1>Query and mutate books together</h1>
  <p class="intro">
    The page queries its initial list during server rendering. After resumption,
    the mutation adds a book and refetches the watched query through
    <a href="/gql"><code>/gql</code></a>.
  </p>

  <section class="result" aria-live="polite">
    <try>
      <await-query|booksResult|
        client=() => createClient()
        query=() => BOOKS_QUERY
      >
        <if=booksResult.error>
          <p role="alert">GraphQL query error: ${booksResult.error.message}</p>
        </if>
        <else>
          <const-mutation/[addBook, mutationResult]
            client=() => createClient()
            mutation=() => ADD_BOOK
            refetchQueries=["Books"]
            awaitRefetchQueries=true
          />
          <button
            type="button"
            disabled=mutationResult.loading
            onClick() {
              void addBook({
                variables: {
                  title: "Kindred",
                  author: "Octavia E. Butler",
                },
              }).catch(() => {});
            }
          >
            Add Kindred
          </button>

          <p class="status">
            <if=mutationResult.loading>Adding and refetching…</if>
            <else-if=mutationResult.error>
              GraphQL mutation error: ${mutationResult.error.message}
            </else-if>
            <else-if=mutationResult.data>
              Added ${mutationResult.data.addBook.title}; the list below came from
              the refetched query.
            </else-if>
            <else>The mutation has not run yet.</else>
          </p>

          <ul class="mutation-list">
            <for|book| of=booksResult.data?.books ?? []>
              <li><strong>${book.title}</strong><span>${book.author}</span></li>
            </for>
          </ul>
        </else>
      </await-query>

      <@placeholder>
        <p>Loading books…</p>
      </@placeholder>
      <@catch|error|>
        <p role="alert">
          GraphQL query error:
          ${error instanceof Error ? error.message : String(error)}
        </p>
      </@catch>
    </try>
  </section>

  <p><a href="/">Return to the server-rendered query</a></p>
</div>
