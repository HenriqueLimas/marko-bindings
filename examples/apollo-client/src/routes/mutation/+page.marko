import { createClient } from "../../apollo-client.marko";
import { ADD_BOOK } from "../../book-mutation.marko";
import { BOOKS_QUERY } from "../../books-query.marko";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Apollo query and mutation example</title>
    <style>
      :root {
        color: #17212b;
        background: #f4f7fa;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 5rem auto;
      }

      .eyebrow {
        color: #b04a1f;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 6vw, 3.75rem);
        line-height: 1;
      }

      .intro,
      .status {
        color: #52606d;
        line-height: 1.6;
      }

      .result {
        min-height: 10rem;
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #dbe2ea;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 1rem 3rem rgb(23 33 43 / 8%);
      }

      button {
        padding: 0.75rem 1rem;
        border: 0;
        border-radius: 0.75rem;
        color: white;
        background: #b04a1f;
        cursor: pointer;
        font: inherit;
        font-weight: 700;
      }

      button:disabled {
        cursor: wait;
        opacity: 0.65;
      }

      ul {
        display: grid;
        gap: 0.75rem;
        margin: 1.5rem 0 0;
        padding: 0;
        list-style: none;
      }

      li {
        padding: 1rem;
        border-radius: 0.75rem;
        background: #fff3ed;
      }

      strong,
      span {
        display: block;
      }

      span {
        margin-top: 0.25rem;
        color: #665f73;
      }

      a {
        color: #9b3d18;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">Marko + Apollo operations</div>
      <h1>Query and mutate books together</h1>
      <p class="intro">
        The page queries its initial list during server rendering. After
        resumption, the mutation adds a book and refetches the watched query
        through <a href="/gql"><code>/gql</code></a>.
      </p>

      <section class="result" aria-live="polite">
        <try>
          <use-query|booksResult|
            client=() => createClient()
            query=() => BOOKS_QUERY()
          >
            <if=booksResult.error>
              <p role="alert">
                GraphQL query error: ${booksResult.error.message}
              </p>
            </if>
            <else>
              <use-mutation/addBook|mutationResult|
                client=() => createClient()
                mutation=() => ADD_BOOK()
                refetchQueries=["Books"]
                awaitRefetchQueries=true
              >
                <button
                  type="button"
                  disabled=mutationResult.loading
                  onClick() {
                    void addBook({
                      variables: {
                        title: "Kindred",
                        author: "Octavia E. Butler",
                      },
                    }).catch(() => {});
                  }
                >
                  Add Kindred
                </button>

                <p class="status">
                  <if=mutationResult.loading>Adding and refetching…</if>
                  <else-if=mutationResult.error>
                    GraphQL mutation error: ${mutationResult.error.message}
                  </else-if>
                  <else-if=mutationResult.data>
                    Added ${mutationResult.data.addBook.title}; the list below came
                    from the refetched query.
                  </else-if>
                  <else>The mutation has not run yet.</else>
                </p>

                <ul>
                  <for|book| of=booksResult.data?.books ?? []>
                    <li>
                      <strong>${book.title}</strong><span>${book.author}</span>
                    </li>
                  </for>
                </ul>
              </use-mutation>
            </else>
          </use-query>

          <@placeholder>
            <p>Loading books…</p>
          </@placeholder>
          <@catch|error|>
            <p role="alert">
              GraphQL query error:
              ${error instanceof Error ? error.message : String(error)}
            </p>
          </@catch>
        </try>
      </section>

      <p><a href="/">Return to the server-rendered query</a></p>
    </main>
  </body>
</html>
