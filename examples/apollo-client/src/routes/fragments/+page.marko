import { createClient } from "../../apollo-client.marko";
import { BOOK_FRAGMENT, BOOKS_QUERY } from "../../books-query.js";

<div
  class="page"
  style="--theme-accent: #176b87; --theme-link: #176b87; --theme-surface: #edf8fb; --theme-detail: #526b73;"
>
  <div class="eyebrow">Apollo fragment cache</div>
  <h1>Books watched by fragment</h1>
  <p class="intro">
    The query populates Apollo's normalized cache. Each plain book is passed
    directly as the serializable <code>from</code> input while the parsed
    fragment uses a resumable getter. After browser resumption, each
    <code>&lt;use-fragment&gt;</code> watches its book for future cache updates.
  </p>

  <section class="result result--tall" aria-live="polite">
    <try>
      <use-query|result| client=() => createClient() query=() => BOOKS_QUERY>
        <if=result.error>
          <p role="alert">GraphQL error: ${result.error.message}</p>
        </if>
        <else>
          <ul>
            <for|book| of=result.data?.books ?? []>
              <li>
                <use-fragment|fragmentResult|
                  client=() => createClient()
                  fragment=() => BOOK_FRAGMENT
                  from=book
                >
                  <strong>
                    ${fragmentResult.data.title ?? "Waiting for browser cache"}
                  </strong>
                  <span>
                    ${fragmentResult.data.author ?? book.author} ·
                    ${fragmentResult.complete ? "complete" : "partial"} fragment
                  </span>
                </use-fragment>
              </li>
            </for>
          </ul>
        </else>
      </use-query>

      <@placeholder>
        <p>Loading books…</p>
      </@placeholder>
      <@catch|error|>
        <p role="alert">
          GraphQL error:
          ${error instanceof Error ? error.message : String(error)}
        </p>
      </@catch>
    </try>
  </section>

  <p><a href="/">Return to the server-rendered query</a></p>
</div>
