import { createSubscriptionClient } from "../../subscription-client.marko";
import { TICK_SUBSCRIPTION } from "../../tick-subscription";

<div class="page" style="--theme-accent: #136f63; --theme-link: #136f63;">
  <div class="eyebrow">Marko + Apollo subscription</div>
  <h1>Stream updates after resumption</h1>
  <p class="intro">
    The server finishes without starting a subscription. In the browser, a local
    Apollo Link emits an incrementing value after Marko resumes the
    server-rendered loading state.
  </p>

  <section class="result" aria-live="polite">
    <const-subscription/result
      client=() => createSubscriptionClient()
      subscription=() => TICK_SUBSCRIPTION
    />
    <if=result.loading>
      <p class="status">Waiting for the first event…</p>
    </if>
    <else-if=result.error>
      <p role="alert">Subscription error: ${result.error.message}</p>
    </else-if>
    <else>
      <p class="status">Latest subscription event</p>
      <output>${result.data?.tick}</output>
    </else>
  </section>

  <p><a href="/">Return to the server-rendered query</a></p>
</div>
