import { createSubscriptionClient } from "../../subscription-client.marko";
import { TICK_SUBSCRIPTION } from "../../tick-subscription.js";

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Apollo subscription example</title>
    <style>
      :root {
        color: #17212b;
        background: #f4f7fa;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 5rem auto;
      }

      .eyebrow {
        color: #136f63;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 6vw, 3.75rem);
        line-height: 1;
      }

      .intro,
      .status {
        color: #52606d;
        line-height: 1.6;
      }

      .result {
        min-height: 10rem;
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #dbe2ea;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 1rem 3rem rgb(23 33 43 / 8%);
      }

      output {
        display: block;
        color: #136f63;
        font-size: 4rem;
        font-weight: 800;
      }

      a {
        color: #136f63;
      }
    </style>
  </head>
  <body>
    <main>
      <div class="eyebrow">Marko + Apollo subscription</div>
      <h1>Stream updates after resumption</h1>
      <p class="intro">
        The server finishes without starting a subscription. In the browser, a
        local Apollo Link emits an incrementing value after Marko resumes the
        server-rendered loading state.
      </p>

      <section class="result" aria-live="polite">
        <use-subscription|result|
          client=() => createSubscriptionClient()
          subscription=() => TICK_SUBSCRIPTION
        >
          <if=result.loading>
            <p class="status">Waiting for the first event…</p>
          </if>
          <else-if=result.error>
            <p role="alert">Subscription error: ${result.error.message}</p>
          </else-if>
          <else>
            <p class="status">Latest subscription event</p>
            <output>${result.data?.tick}</output>
          </else>
        </use-subscription>
      </section>

      <p><a href="/">Return to the server-rendered query</a></p>
    </main>
  </body>
</html>
