export interface Input {
  content: Marko.Body;
}

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Marko Apollo Client examples</title>
    <style>
      :root {
        color: #17212b;
        background: #f4f7fa;
        font-family:
          Inter,
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          sans-serif;
      }

      body {
        margin: 0;
      }

      main {
        width: min(42rem, calc(100% - 2rem));
        margin: 5rem auto;
      }

      .eyebrow {
        color: var(--theme-accent);
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0.5rem 0;
        font-size: clamp(2rem, 6vw, 3.75rem);
        line-height: 1;
      }

      .intro,
      .status {
        color: #52606d;
        line-height: 1.6;
      }

      .result {
        min-height: 10rem;
        margin-top: 2rem;
        padding: 1.5rem;
        border: 1px solid #dbe2ea;
        border-radius: 1rem;
        background: white;
        box-shadow: 0 1rem 3rem rgb(23 33 43 / 8%);
      }

      .result--tall {
        min-height: 12rem;
      }

      button {
        padding: 0.75rem 1rem;
        border: 0;
        border-radius: 0.75rem;
        color: white;
        background: var(--theme-accent);
        cursor: pointer;
        font: inherit;
        font-weight: 700;
      }

      button:disabled {
        cursor: wait;
        opacity: 0.65;
      }

      ul {
        display: grid;
        gap: 0.75rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .mutation-list {
        margin-top: 1.5rem;
      }

      li {
        padding: 1rem;
        border-radius: 0.75rem;
        background: var(--theme-surface);
      }

      li strong,
      li span {
        display: block;
      }

      li span {
        margin-top: 0.25rem;
        color: var(--theme-detail);
      }

      output {
        display: block;
        color: var(--theme-accent);
        font-size: 4rem;
        font-weight: 800;
      }

      a {
        color: var(--theme-link, var(--theme-accent));
      }
    </style>
  </head>
  <body>
    <main>
      <${input.content}/>
    </main>
  </body>
</html>
