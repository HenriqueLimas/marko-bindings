import RegistrationForm from "../registration-form.marko";

<main>
  <section class="intro">
    <div class="eyebrow">Marko Run × TanStack Form</div>
    <h1>Declare fields.<br><em>Resume the form.</em></h1>
    <p>
      TanStack owns validation and submission while Marko's tag variables keep
      every native control reactive. Conditional markup owns conditional field
      lifecycles—without serializing a form controller.
    </p>
    <ul>
      <li><code>&lt;const-form&gt;</code> owns form state and actions</li>
      <li><code>&lt;const-field&gt;</code> owns registration and validation</li>
      <li><code>:=</code> writes native input changes through to TanStack</li>
    </ul>
  </section>

  <RegistrationForm/>
</main>

