import {
  cartStore,
  type CartState,
  type CartSummary,
  memberAtom,
  summaryStore,
} from "./cart-store";

static const price = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
});

<init-tanstack-store=() => cartStore/>

<section class="cart" aria-labelledby="cart-title">
  <const-selected/cart=(state: CartState) => state/>
  <header class="cart__header">
    <div>
      <span class="label">Current order</span>
      <h2 id="cart-title">Desk essentials</h2>
    </div>
    <span class="count">${cart.items.length} products</span>
  </header>

  <div class="items">
    <for|item| of=cart.items>
      <article class="item">
        <div class="item__index" aria-hidden="true">${item.id}</div>
        <div class="item__copy">
          <strong>${item.name}</strong><span>${item.detail}</span>
          <button
            type="button"
            class="remove"
            onClick() {
              cartStore.actions.remove(item.id);
            }
          >
            Remove
          </button>
        </div>
        <div class="quantity" aria-label=`Quantity for ${item.name}`>
          <button
            type="button"
            aria-label=`Decrease ${item.name}`
            disabled=item.quantity === 1
            onClick() {
              cartStore.actions.decrement(item.id);
            }
          >
            −
          </button>
          <output>${item.quantity}</output>
          <button
            type="button"
            aria-label=`Increase ${item.name}`
            onClick() {
              cartStore.actions.increment(item.id);
            }
          >
            +
          </button>
        </div>
        <strong class="price">
          ${price.format(item.price * item.quantity)}
        </strong>
      </article>
    </for>
    <if=!cart.items.length>
      <div class="empty">
        <strong>Your desk is clear.</strong>
        <span>The binding is still subscribed.</span>
      </div>
    </if>
  </div>

  <let-atom/member=() => memberAtom/>
  <label class="member">
    <input
      type="checkbox"
      checked=member
      onChange(_event, element) {
        member = element.checked;
      }
    >
    <span>
      <strong>Studio member</strong><small>Apply a 10% member discount</small>
    </span>
  </label>
  <init-tanstack-store=() => summaryStore/>
  <const-selected/summary=(state: CartSummary) => state/>
  <dl class="summary">
    <div>
      <dt>Subtotal</dt>
      <dd>${price.format(summary.subtotal)}</dd>
    </div>
    <if=summary.discount>
      <div class="discount">
        <dt>Member discount</dt>
        <dd>−${price.format(summary.discount)}</dd>
      </div>
    </if>
    <div class="total">
      <dt>Total</dt>
      <dd>${price.format(summary.total)}</dd>
    </div>
  </dl>

  <footer>
    <p>
      Each readable source is initialized before the binding that consumes it.
    </p>
  </footer>
</section>

<style>
  .cart {
    overflow: hidden;
    border: 1px solid rgb(23 54 46 / 10%);
    border-radius: 1.5rem;
    background: #fffdf8;
    box-shadow: 0 2rem 5rem rgb(57 69 61 / 15%);
  }

  .cart__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.6rem 1.8rem 1.3rem;
  }

  .label {
    color: #bd5425;
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0.3rem 0 0;
    color: #17362e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.75rem;
    font-weight: 500;
  }

  .count {
    color: #7b8580;
    font-size: 0.75rem;
  }

  .items {
    border-block: 1px solid #e8e9e3;
  }

  .item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 5rem;
    gap: 0.9rem;
    align-items: center;
    padding: 1rem 1.8rem;
    border-bottom: 1px solid #eeeee8;
  }

  .item:last-child {
    border-bottom: 0;
  }

  .item__index {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.7rem;
    color: #8b522f;
    background: #f1dfcf;
    font-family: Georgia, "Times New Roman", serif;
  }

  .item__copy {
    display: grid;
    gap: 0.15rem;
  }

  .item__copy strong {
    color: #2a3c36;
    font-size: 0.9rem;
  }

  .item__copy span {
    color: #89908d;
    font-size: 0.72rem;
  }

  .remove {
    width: fit-content;
    padding: 0;
    border: 0;
    color: #bd5425;
    background: transparent;
    font-size: 0.68rem;
  }

  .quantity {
    display: flex;
    align-items: center;
    border: 1px solid #dfe1dc;
    border-radius: 0.55rem;
  }

  .quantity button {
    width: 1.8rem;
    height: 1.8rem;
    padding: 0;
    border: 0;
    color: #53635d;
    background: transparent;
  }

  .quantity button:disabled {
    color: #c7cbc8;
    cursor: default;
  }

  .quantity output {
    min-width: 1.5rem;
    color: #263b34;
    font-size: 0.78rem;
    text-align: center;
  }

  .price {
    color: #263b34;
    font-size: 0.85rem;
    text-align: right;
  }

  .empty {
    display: grid;
    gap: 0.25rem;
    min-height: 9rem;
    place-content: center;
    color: #929a96;
    text-align: center;
  }

  .empty strong {
    color: #66736e;
  }

  .member {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin: 1.2rem 1.8rem;
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
    background: #f3f5f0;
    cursor: pointer;
  }

  .member input {
    width: 1rem;
    height: 1rem;
    accent-color: #bd5425;
  }

  .member span {
    display: grid;
    gap: 0.1rem;
  }

  .member strong {
    color: #31433d;
    font-size: 0.82rem;
  }

  .member small {
    color: #818a86;
