  }

  footer {
    padding: 0.85rem 1.8rem;
    color: #b9c7c1;
    background: #17362e;
  }

  footer p {
    margin: 0;
    font-size: 0.72rem;
  }

  footer code {
    color: #f2b99e;
    background: transparent;
  }

  @media (max-width: 38rem) {
    .cart__header,
    .item,
    .summary,
    footer {
      padding-inline: 1rem;
    }

    .member {
      margin-inline: 1rem;
    }

    .item {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }

    .quantity {
      grid-column: 2;
      width: fit-content;
    }

    .price {
      grid-column: 3;
      grid-row: 2;
    }
  }
</style>
